+    || supplied.ok !== true
+    || supplied.ok !== resolved.ok
+    || supplied.issue !== null
+    || supplied.issue !== resolved.issue
+    || supplied.storyId !== resolved.storyId
+    || supplied.reviewSeries !== resolved.reviewSeries
+    || supplied.canonicalCrDir !== resolved.canonicalCrDir
+    || supplied.crDir !== resolved.crDir
+    || supplied.compatibilityMode !== resolved.compatibilityMode
+    || !Array.isArray(supplied.legacyArtifactPaths)) {
+    return { ok: false, reason: "frozen-cr-context-mismatch" };
+  }
+  const canonicalExpected = `state/code-reviews/${resolved.storyId}-code-review`;
+  const legacyPaths = supplied.legacyArtifactPaths as unknown[];
+  const stableLegacy = legacyPaths.every((entry) => typeof entry === "string" && isTestPortablePath(entry))
+    && new Set(legacyPaths).size === legacyPaths.length
+    && [...legacyPaths].sort(comparePathBytes).every((entry, index) => entry === legacyPaths[index]);
+  const modeCompatible = supplied.compatibilityMode === "canonical"
+    ? supplied.crDir === canonicalExpected
+    : supplied.compatibilityMode === "legacy-resume"
+      && legacyPaths.includes(supplied.crDir)
+      && typeof supplied.crDir === "string"
+      && path.posix.basename(supplied.crDir).startsWith(`${resolved.storyId}-`)
+      && path.posix.basename(supplied.crDir).endsWith("-code-review");
+  if (supplied.canonicalCrDir !== canonicalExpected || !stableLegacy || !modeCompatible
+    || JSON.stringify(legacyPaths) !== JSON.stringify(resolved.legacyArtifactPaths)) {
+    return { ok: false, reason: "frozen-cr-context-mismatch" };
+  }
+  await mutation();
+  return { ok: true };
+}
+
+function isTestPortablePath(value: unknown): value is string {
+  return typeof value === "string"
+    && value.length > 0
+    && !value.includes("\\")
+    && !path.posix.isAbsolute(value)
+    && value.split("/").every((part) => part !== "" && part !== "." && part !== "..");
+}
+
+type TitleBearingLedgerEntry = {
+  path: string;
+  line: number;
+  token: string;
+  role: "active-canonical" | "compatibility-contract" | "legacy-fixture" | "regression-assertion";
+  rationale: string;
+};
+
+async function scanTitleBearingCandidateCorpus(): Promise<TitleBearingLedgerEntry[]> {
+  const roots = [
+    path.join(IMPLEMENTATION_ROOT, "speclite-code-review-contract"),
+    path.join(IMPLEMENTATION_ROOT, "speclite-goal-orchestrator-epic-story-code-review-runner"),
+    ...LEAF_IDS.map((leafId) => path.join(IMPLEMENTATION_ROOT, leafId)),
+  ];
+  const explicitFiles = [
+    path.join(process.cwd(), "assets/source/speclite/sdlc-skills/module-help.csv"),
+    path.join(process.cwd(), "assets/source/speclite/README.md"),
+    path.join(process.cwd(), "assets/source/speclite/README.en.md"),
+    path.join(process.cwd(), "docs/reference/skills/sdlc-workflows.md"),
+    path.join(process.cwd(), "docs/reference/workflow-artifact-layout.md"),
+    path.join(process.cwd(), "release/packaging-manifest.json"),
+    path.join(process.cwd(), "test/code-review-contract.test.ts"),
+  ];
+  const files = [
+    ...await scanCandidateRoots(roots, process.cwd()),
+    ...await scanCandidateRoots(explicitFiles, process.cwd(), { explicitFilesOnly: true }),
+  ];
+  const unique = new Set(files);
+  if (unique.size !== files.length) throw new Error("duplicate-candidate-path");
+  const patterns = titleBearingTokenPatterns();
+  const ledger: Array<TitleBearingLedgerEntry & { offset: number }> = [];
+  for (const absolute of [...unique].sort(comparePathBytes)) {
+    let bytes: Buffer;
+    try {
+      bytes = await readFile(absolute);
+    } catch {
+      throw new Error("candidate-read-failure");
+    }
+    const content = bytes.toString("utf8");
+    for (const pattern of patterns) {
+      for (const match of content.matchAll(pattern)) {
+        const token = match[0];
+        const offset = Buffer.byteLength(content.slice(0, match.index), "utf8");
+        const relative = path.relative(process.cwd(), absolute).split(path.sep).join("/");
+        const line = content.slice(0, match.index).split("\n").length;
+        const classification = classifyTitleBearingMatch(relative, token);
+        ledger.push({ path: relative, line, token, ...classification, offset });
+      }
+    }
+  }
+  ledger.sort((left, right) => comparePathBytes(left.path, right.path) || left.offset - right.offset || comparePathBytes(left.token, right.token));
+  return ledger.map(({ offset: _offset, ...entry }) => entry);
+}
+
+async function scanCandidateRoots(
+  roots: string[],
+  containmentRoot: string,
+  options: { explicitFilesOnly?: boolean } = {},
+): Promise<string[]> {
+  const resolvedContainment = path.resolve(containmentRoot);
+  const results: string[] = [];
+  const seen = new Set<string>();
+  async function visit(absolute: string, explicit: boolean): Promise<void> {
+    const relative = path.relative(resolvedContainment, absolute);
+    if (relative === ".." || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) throw new Error("candidate-path-escape");
+    if (seen.has(absolute)) throw new Error("duplicate-candidate-path");
+    seen.add(absolute);
+    const metadata = await lstat(absolute).catch(() => null);
+    if (!metadata || metadata.isSymbolicLink()) throw new Error("unsafe-candidate-entry");
+    if (metadata.isFile()) {
+      results.push(absolute);
+      return;
+    }
+    if (!metadata.isDirectory()) throw new Error("unsafe-candidate-entry");
+    if (explicit || options.explicitFilesOnly) throw new Error("unsafe-explicit-candidate");
+    const children = await readdir(absolute, { withFileTypes: true }).catch(() => null);
+    if (!children) throw new Error("candidate-scan-failure");
+    for (const child of children.sort((a, b) => comparePathBytes(a.name, b.name))) {
+      await visit(path.join(absolute, child.name), false);
+    }
+  }
+  for (const root of roots) await visit(root, options.explicitFilesOnly === true);
+  return results;
+}
+
+function titleBearingTokenPatterns(): RegExp[] {
+  const identityName = String.raw`story(?:Id|_id|\.id)`;
+  const titleName = String.raw`(?:story(?:Key|_key|Slug|_slug|Name|_name|Title|_title|Filename|_filename|\.key|\.slug|\.name|\.title|\.filename)|title|name|slug|filename)`;
+  const placeholder = (name: string): string => String.raw`(?:\{\{?${name}\}?\}|<${name}>|\$\{${name}\}|\$${name})`;
+  const storyIdentity = placeholder(identityName);
+  const storyTitle = placeholder(titleName);
+  const bareIdentity = String.raw`(?:story(?:Id|_id|\.id)|\$story(?:Id|_id))`;
+  const bareTitle = String.raw`(?:story(?:Key|_key|Slug|_slug|Name|_name|Title|_title|Filename|_filename|\.key|\.slug|\.name|\.title|\.filename)|title|name|slug|filename|\$story(?:Key|_key|Slug|_slug|Name|_name|Title|_title|Filename|_filename))`;
+  const bracedIdentity = String.raw`(?:story(?:Id|_id|\.id))`;
+  const bracedTitle = titleName;
+  const boundary = String.raw`(?=[/\\\x60'"\s]|$)`;
+  return [
+    new RegExp(`${storyIdentity}[-_ ]${storyTitle}-code-review${boundary}`, "gu"),
+    new RegExp(`${storyTitle}-code-review${boundary}`, "gu"),
+    new RegExp(String.raw`[1-9][0-9]*-[1-9][0-9]*-(?!code-review${boundary})[^/\\\r\n\x60'"]+?-code-review${boundary}`, "gu"),
+    new RegExp(`${bareIdentity}\\s*\\+\\s*["']-["']\\s*\\+\\s*${bareTitle}\\s*\\+\\s*["']-code-review["']`, "gu"),
+    new RegExp(`\\[\\s*${bareIdentity}\\s*,\\s*${bareTitle}\\s*,\\s*["']code-review["']\\s*\\]\\.join\\(\\s*["']-["']\\s*\\)`, "gu"),
+    new RegExp(`(?:crDir|cr_dir|codeReviewDir|code_review_dir)\\s*[:=]\\s*${bareIdentity}\\s*\\+\\s*["']-["']\\s*\\+\\s*${bareTitle}\\s*\\+\\s*["']-code-review["']`, "gu"),
+    new RegExp(`\\$\\{${bracedIdentity}\\}["']-["']\\$\\{${bracedTitle}\\}["']-code-review["']`, "gu"),
+    new RegExp(`["']\\{${bracedIdentity}\\}-["']\\s*\\+\\s*["']\\{${bracedTitle}\\}-code-review["']`, "gu"),
+    new RegExp(`\\$\\{${bracedIdentity}\\}\\$\\{["']-["']\\}\\$\\{${bracedTitle}\\}\\$\\{["']-code-review["']\\}`, "gu"),
+  ];
+}
+
+function classifyTitleBearingMatch(pathname: string, token: string): Pick<TitleBearingLedgerEntry, "role" | "rationale"> {
+  if (pathname === "test/code-review-contract.test.ts" && /(?:old|first|second)-title/u.test(token)) {
+    return { role: "legacy-fixture", rationale: "Story 11.9 resolver compatibility regression fixture" };
+  }
+  if (pathname === "test/code-review-contract.test.ts") {
+    return { role: "regression-assertion", rationale: "Story 11.9 bounded detector regression assertion" };
+  }
+  throw new Error(`unclassified-title-bearing-match:${pathname}:${token}`);
+}
+
+function comparePathBytes(left: string, right: string): number {
+  return Buffer.compare(Buffer.from(left, "utf8"), Buffer.from(right, "utf8"));
+}
