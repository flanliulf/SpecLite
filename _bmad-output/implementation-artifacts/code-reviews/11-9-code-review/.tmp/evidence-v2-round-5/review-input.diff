+      continue;
+    }
+    if (!isPortableProjectRelativePath(pathValue) || typeof key !== "string" || key.length === 0 || !validTerminalState(expectedTerminalState)) return null;
+    bindings[role] = { required: true, path: pathValue, key, expectedTerminalState };
+  }
+  return bindings;
+}
+
+if (process.argv[1] && path.basename(process.argv[1]) === "resolve-cr-directory.mjs") {
+  await runCli();
+}
