+    values[name] = value;
+  }
+  for (const core of ["project-root", "implementation-artifacts", "story-id"]) {
+    if (!Object.hasOwn(values, core)) return null;
+  }
+  const trackerBindings = parseTrackerBindings(values);
+  if (trackerBindings === null) return null;
+  return {
+    projectRoot: values["project-root"],
+    implementationArtifacts: values["implementation-artifacts"],
+    storyId: values["story-id"],
+    reviewSeries: values["review-series"] ?? "main",
+    trackerBindings,
+  };
+}
+
+function parseTrackerBindings(values) {
+  const bindings = {};
+  for (const role of ["story", "sprint", "workflow"]) {
+    const requiredValue = values[`${role}-tracker-required`];
+    if (!["true", "false"].includes(requiredValue)) return null;
+    const required = requiredValue === "true";
+    const pathValue = values[`${role}-tracker-path`];
+    const key = values[`${role}-tracker-key`];
+    const expectedTerminalState = values[`${role}-tracker-terminal-state`];
+    if (!required) {
