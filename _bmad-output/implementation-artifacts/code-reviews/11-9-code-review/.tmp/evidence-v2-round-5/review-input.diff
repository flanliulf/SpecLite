+}
+
+function parseArguments(args) {
+  const known = new Set([
+    "project-root", "implementation-artifacts", "story-id", "review-series",
+    "story-tracker-required", "story-tracker-path", "story-tracker-key", "story-tracker-terminal-state",
+    "sprint-tracker-required", "sprint-tracker-path", "sprint-tracker-key", "sprint-tracker-terminal-state",
+    "workflow-tracker-required", "workflow-tracker-path", "workflow-tracker-key", "workflow-tracker-terminal-state",
+  ]);
