# Example only. Runtime configuration may be supplied by user request or {project-root}/_speclite/config.toml.

[modules.sdlc]
project_knowledge = "{project-root}/docs"
planning_artifacts = "{project-root}/_speclite-output/planning-artifacts"

[skills.speclite-brownfield-backend-tech-stack-digger]
# The user request should provide output_dir. This example shows a conventional Speclite location.
output_dir = "{project_knowledge}/analysis"
report_name = "backend-tech-stack.md"
focus = "backend"
allow_overwrite = false
include_evidence_summary = true
include_unconfirmed_section = true
